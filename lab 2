use of scanf function -

Code 1 -
  #include <stdio.h>
  int main()
  {
    int age;

    printf("Enter your age: ");
    scanf("%d", &age);

    printf("Your age is %d", age);

    return 0;
   }


Code 2 (sum of two numbers) -
     #include <stdio.h>
     int main() {
    int num1, num2, sum;

    // Ask the user for input
    printf("Enter the first number: ");
    scanf("%d", &num1);

    printf("Enter the second number: ");
    scanf("%d", &num2);

    // Calculate the sum
    sum = num1 + num2;

    // Display the result
    printf("The sum of %d and %d is: %d\n", num1, num2, sum);

    return 0;
  }

Code 3 -
  #include <stdio.h>
   int main()
  {
    int age;
    float marks;
    char grade;

    printf("Enter your age: ");
    scanf("%d", &age);

    printf("Enter your marks: ");
    scanf("%f", &marks);

    printf("Enter your grade: ");
    scanf(" %c", &grade);

    printf("\nAge = %d", age);
    printf("\nMarks = %f", marks);
    printf("\nGrade = %c", grade);

    return 0;
  }

