Q2. Input your name and display it.
#include <stdio.h>

int main()
{
    char name[50];

    printf("Enter your name: ");
    scanf("%s", name);

    printf("Name: %s", name);

    return 0;
}

Q3. Input your age and display it.
#include <stdio.h>

int main()
{
    int age;

    printf("Enter your age: ");
    scanf("%d", &age);

    printf("Age: %d", age);

    return 0;
}

